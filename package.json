{
  "name": "cosmos-stories",
  "version": "1.0.1",
  "description": "Stories-style viewer for NASA's Astronomy Picture of the Day, built on a custom Angular carousel engine.",
  "license": "MIT",
  "author": "Serge Tiutin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiutin/cosmos-stories.git"
  },
  "homepage": "https://stiutin.github.io/cosmos-stories/",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/ensure-data.ts",
    "start": "ng serve",
    "prebuild": "node scripts/ensure-data.ts",
    "build": "ng build",
    "build:lib": "ng build carousel",
    "watch": "ng build --watch --configuration development",
    "serve": "node e2e/serve.ts",
    "data:fetch": "node --env-file-if-exists=.env scripts/fetch-apod.ts",
    "data:sample": "node -e \"require('fs').cpSync('data/apod.sample.json','public/data/apod.json')\"",
    "test": "ng test cosmos-stories --watch=false && ng test carousel --watch=false",
    "test:watch": "ng test cosmos-stories",
    "test:lib": "ng test carousel --watch=false",
    "test:coverage": "ng test carousel --watch=false --coverage",
    "test:scripts": "node --test scripts/*.test.ts",
    "e2e:build": "ng build --base-href /cosmos-stories/ && node scripts/e2e-prepare.ts",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:run": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "prelighthouse": "npm run e2e:build",
    "lighthouse": "lhci autorun",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "eslint . && stylelint \"src/**/*.scss\" \"projects/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" \"projects/**/*.scss\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.e2e.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:scripts"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
