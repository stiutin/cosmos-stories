{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/serve.ts",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4400/cosmos-stories/",
        "http://localhost:4400/cosmos-stories/stories/latest/2026-09-22"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/cosmos-stories/$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.02
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/stories/",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.02
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
